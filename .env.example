# Copy to .env and fill in real values. Never commit .env.

# Database (backend runs on the host; docker-compose publishes db on localhost:5432)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=codelearning
DATABASE_URL=postgresql://postgres:change-me@localhost:5432/codelearning

# Connection pool (optional, defaults shown)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true
DB_ECHO=false

# Redis (Celery broker + cache)
REDIS_URL=redis://localhost:6379/0

# Google AI (Gemini)
GOOGLE_API_KEY=your-google-ai-api-key-here
# Optional (these are the defaults)
# GEMINI_MODEL=gemini-3-flash-preview
# GEMINI_TIMEOUT_SECONDS=120

# JWT secrets (min 32 characters, must differ; generate with: openssl rand -hex 32)
JWT_SECRET_KEY=your-secret-key-here
JWT_REFRESH_SECRET=your-refresh-secret-here
# Token lifetimes (optional, defaults shown)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Environment
ENVIRONMENT=development
DEBUG=true
ALLOWED_ORIGINS=http://localhost:5173

# File storage
UPLOAD_DIR=./storage/uploads
# Where the backend stores uploaded code (absolute, or relative to the repository root)
UPLOAD_STORAGE_PATH=./storage/uploads
MAX_UPLOAD_SIZE_MB=10

# Frontend (Vite reads VITE_* from frontend/.env)
VITE_API_BASE_URL=http://localhost:8000/api/v1
VITE_ENVIRONMENT=development
